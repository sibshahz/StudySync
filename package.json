{
  "name": "code",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=packages/database/prisma/schema.prisma",
    "database:generate": "turbo run db:generate",
    "database:migrate": "turbo run db:migrate",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@9.6.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
